# 답변 생성에만 쓴다. 키가 없어도 검색, 차단 판정, 평가(evaluate.py, calibrate.py)는 돈다.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 답변 모델 ("제공자:모델ID", 뒤에 @effort 를 붙일 수 있다)
# 기본은 이 PC 에서 도는 로컬 모델 (Ollama, 비용 없음): ollama pull gemma3:4b
ANSWER_MODEL=ollama:gemma3:4b
# 비교할 모델 (쉼표로 구분). 클라우드 모델은 위에 키를 넣고 추가한다
# 예: openai:<모델ID>, anthropic:claude-fable-5-1
COMPARE_MODELS=ollama:gemma3:4b,ollama:nemotron-3-nano:4b@nothink

# 청크
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MIN_CHUNK_SIZE=200
TOP_K=5

# 근거 충분성 기준 (calibrate.py 결과. 비워 두면 config.py 기본값)
# EVIDENCE_MIN_SCORE=2.5
# EVIDENCE_MIN_COVERAGE=0.67

# 선택 경로: 임베딩 + ChromaDB (기본 검색에는 쓰지 않는다)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
SIMILARITY_THRESHOLD=0.35
EMBEDDING_BATCH_SIZE=64
CHROMA_COLLECTION_NAME=ch334u_datasheet
